# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Override global gitignore (which ignores Python build dirs that collide with our source)
!lib/
!build/

node_modules
# dependencies
/node_modules
/.pnp
.pnp.js

# Lockfiles from other package managers (this repo is Bun-only; canonical lock is bun.lock)
/package-lock.json
/pnpm-lock.yaml
/yarn.lock

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# vercel
.vercel
.playwright-mcp/
.playwright-cli/

# claude code session artifacts + dev audit dumps
# Ignore .claude/ contents, but track shared skills + local settings.
.claude/*
!.claude/skills/
!.claude/settings.local.json
/site-audit/

# screenshots — ignore loose PNGs everywhere except inside docs/ and public/
*.png
!docs/**/*.png
!public/**/*.png

.compound-engineering/*.local.yaml
.env.local
docs/screenshots/

# site-capture skill output
captures/out/

# private, local-only context (never commit)
docs/personal_life/
